# Node.js runtime bundled in the Android app.
#
# Built by .github/workflows/android.yml (android/node/build-node.sh) and kept
# in the GitHub Actions cache, keyed on the contents of android/node/. Any change
# here or to the scripts next to it triggers a fresh 1–1.5 h cross-compile.
# Bump RUNTIME_REVISION to force a rebuild without other changes.
NODE_VERSION=v24.21.0
NDK_VERSION=r28c
MIN_SDK=29
RUNTIME_REVISION=1
