# Node.js runtime bundled in the Android app.
#
# Built by the Build workflow of Sienci-Labs/node_24_APK (android/node/build-node.sh)
# and published there as a release tagged by android/scripts/node-runtime-tag.sh,
# which hashes android/node/. Any change here or to the scripts next to it needs
# a new runtime release (a 1–1.5 h cross-compile) before android.yml can pass.
# Bump RUNTIME_REVISION to force a rebuild without other changes.
NODE_VERSION=v24.21.0
NDK_VERSION=r28c
MIN_SDK=29
RUNTIME_REVISION=1
